# =============================================
# PRACHI BEAUTY SHOP - ENVIRONMENT VARIABLES
# =============================================
# COPY this file, rename to .env, fill in your values
# NEVER commit .env to GitHub!

# Server port
PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE_NAME
MONGO_URI=mongodb+srv://yourUsername:yourPassword@cluster0.mongodb.net/prachiBeautyShop

# JWT Secret key - make this long and random
# You can generate one at: https://randomkeygen.com
JWT_SECRET=prachi_beauty_super_secret_jwt_key_change_this_2025

# JWT expiry
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS - update when you deploy)
FRONTEND_URL=http://127.0.0.1:5500
